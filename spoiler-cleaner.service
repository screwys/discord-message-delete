[Unit]
Description=Spoiler Cleaner Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/discord-message-delete
ExecStart=%h/Projects/discord-message-delete/spoiler-cleaner -config config.json -env .env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
